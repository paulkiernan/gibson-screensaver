# Maintainer: Paul Kiernan <paulkiernan1@gmail.com>
#
# gibson-screensaver-bin: the same program as `gibson-screensaver` (../aur/),
# installed from the release's prebuilt Linux tarball instead of compiled from
# the tag tarball. The AUR requires the `-bin` suffix for a package built from
# prebuilt deliverables when the sources are available, and they are - the source
# package beside this one. It exists to save that user a heavy wgpu + winit + ash
# compile; see ../aur/README.md for the shared reasoning behind the executable
# name, the descriptor path and why both packages are worth publishing.
#
# `depends` is the same hand-derived list as the source package, because this
# binary also dlopen()s nearly every library it uses and namcap cannot see any of
# them either; ../aur/PKGBUILD explains each entry.

pkgname=gibson-screensaver-bin
pkgver=2.1.2
pkgrel=1
pkgdesc='Rust/wgpu recreation of the Gibson tower-city flythrough from Hackers (1995); prebuilt xscreensaver hack'
arch=('x86_64')
url='https://github.com/paulkiernan/gibson-screensaver'
license=('GPL-3.0-or-later')
install='gibson-screensaver-bin.install'

# Both packages install /usr/bin/gibson-screensaver and the same descriptor, so
# they must never be installed together; `provides` lets anything that depends
# on the source package be satisfied by this one too.
provides=('gibson-screensaver')
conflicts=('gibson-screensaver')

depends=(
  'glibc'
  'gcc-libs'
  'libx11'
  'libxcb'
  'libxcursor'
  'libxi'
  'libxkbcommon'
  'libxkbcommon-x11'
  'wayland'
  'vulkan-icd-loader'
)

optdepends=(
  'xscreensaver: run it as an xscreensaver hack (X11 only)'
  'vulkan-radeon: Vulkan driver for AMD GPUs'
  'vulkan-intel: Vulkan driver for Intel GPUs'
  'vulkan-nouveau: Vulkan driver for NVIDIA GPUs (Nouveau)'
  'nvidia-utils: Vulkan driver for NVIDIA GPUs (proprietary)'
  'vulkan-swrast: software Vulkan rasteriser (lavapipe), for machines with no GPU driver'
)

# The Linux asset is one directory holding the binary, the descriptor and a
# README.txt; it does not carry the licence, so that is pulled from the same tag
# separately. Both digests are measured from the published bytes - see the
# digests table in ../aur/README.md.
source=(
  "gibson-screensaver-linux-x86_64-$pkgver.tar.gz::https://github.com/paulkiernan/gibson-screensaver/releases/download/$pkgver/gibson-screensaver-linux-x86_64.tar.gz"
  "LICENSE-$pkgver::https://raw.githubusercontent.com/paulkiernan/gibson-screensaver/$pkgver/LICENSE"
)
sha256sums=('483ac51e5d17e8991cd6cdefe1e4deed83f4deecb1deb987566abef7ff894246'
            '0b383d5a63da644f628d99c33976ea6487ed89aaa59f0b3257992deac1171e6b')

package() {
  cd "$srcdir/gibson-screensaver-linux-x86_64"

  install -Dm0755 gibson-app "$pkgdir/usr/bin/gibson-screensaver"

  install -Dm0644 gibson-screensaver.xml \
    "$pkgdir/usr/share/xscreensaver/config/gibson-screensaver.xml"

  install -Dm0644 "$srcdir/LICENSE-$pkgver" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm0644 README.txt "$pkgdir/usr/share/doc/$pkgname/README.txt"
}
